generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  pending_verification
  active
  suspended
  deleted
}

enum StoryStatus {
  draft
  published
  completed
  archived
  suspended
}

enum ChapterStatus {
  draft
  scheduled
  published
  unpublished
  archived
}

enum StoryTagKind {
  type
  setting
  tone
  content
  theme
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  email              String        @unique
  username           String        @unique
  passwordHash       String        @map("password_hash")
  accountStatus      AccountStatus @default(pending_verification) @map("account_status")
  isAdmin            Boolean       @default(false) @map("is_admin")
  emailVerifiedAt    DateTime?     @map("email_verified_at")
  writerOnboardedAt  DateTime?     @map("writer_onboarded_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")
  profile            UserProfile?
  stories            Story[]
  ratings            StoryRating[]
  chapterComments    ChapterComment[]
  commentVotes       CommentVote[]
  wallPostsAuthored  WallPost[]     @relation("WallPostAuthor")
  wallPostsReceived  WallPost[]     @relation("WallPostProfile")
  following          UserFollow[]   @relation("Follower")
  followers          UserFollow[]   @relation("Following")

  @@map("users")
}

model UserProfile {
  userId        String   @id @map("user_id") @db.Uuid
  displayName   String   @map("display_name")
  bio           String?  @db.VarChar(500)
  avatarUrl     String?  @map("avatar_url")
  donationUrl   String?  @map("donation_url")
  locale        String   @default("es")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Story {
  id                   String       @id @default(uuid()) @db.Uuid
  authorId             String       @map("author_id") @db.Uuid
  slug                 String       @unique
  title                String       @db.VarChar(150)
  synopsis             String       @db.VarChar(3000)
  status               StoryStatus  @default(draft)
  isMature             Boolean      @default(false) @map("is_mature")
  coverUrl             String?      @map("cover_url")
  attributionName      String?      @map("attribution_name") @db.VarChar(150)
  sourceUrl            String?      @map("source_url")
  sourceLicense        String?      @map("source_license") @db.VarChar(120)
  importKey            String?      @unique @map("import_key") @db.VarChar(200)
  languageCode         String       @default("es") @map("language_code")
  wordCount            Int          @default(0) @map("word_count")
  publishedChapterCount Int         @default(0) @map("published_chapter_count")
  publishedAt          DateTime?    @map("published_at")
  completedAt          DateTime?    @map("completed_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  archivedAt           DateTime?    @map("archived_at")
  author               User         @relation(fields: [authorId], references: [id])
  chapters             Chapter[]
  genres               StoryGenre[]
  tags                 StoryTag[]
  ratings              StoryRating[]
  readingEvents        ReadingEvent[]
  comments             ChapterComment[]

  @@index([authorId, updatedAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@map("stories")
}

model Genre {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique @db.VarChar(80)
  slug      String       @unique @db.VarChar(80)
  isActive  Boolean      @default(true) @map("is_active")
  sortOrder Int          @default(0) @map("sort_order")
  stories   StoryGenre[]

  @@map("genres")
}

model StoryGenre {
  storyId String @map("story_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([storyId, genreId])
  @@map("story_genres")
}

model Tag {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique @db.VarChar(100)
  slug      String       @unique @db.VarChar(110)
  kind      StoryTagKind
  isActive  Boolean      @default(true) @map("is_active")
  sortOrder Int          @default(0) @map("sort_order")
  stories   StoryTag[]

  @@index([kind, sortOrder])
  @@map("tags")
}

model StoryTag {
  storyId String @map("story_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([storyId, tagId])
  @@index([tagId, storyId])
  @@map("story_tags")
}

model Chapter {
  id                String        @id @default(uuid()) @db.Uuid
  storyId           String        @map("story_id") @db.Uuid
  slug              String        @db.VarChar(150)
  title             String        @db.VarChar(150)
  status            ChapterStatus @default(draft)
  position          Int
  contentJson       Json          @map("content_json")
  plainText         String        @map("plain_text")
  contentVersion    Int           @default(1) @map("content_version")
  wordCount         Int           @default(0) @map("word_count")
  estimatedReadMin  Int           @default(0) @map("estimated_read_minutes")
  publishedAt       DateTime?     @map("published_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  archivedAt        DateTime?     @map("archived_at")
  story             Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  revisions         ChapterRevision[]
  readingEvents     ReadingEvent[]
  comments          ChapterComment[]

  @@unique([storyId, slug])
  @@unique([storyId, position])
  @@index([storyId, status, position])
  @@map("chapters")
}

model ChapterComment {
  id             String   @id @default(uuid()) @db.Uuid
  storyId        String   @map("story_id") @db.Uuid
  chapterId      String   @map("chapter_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  authorId       String?  @map("author_id") @db.Uuid
  authorName     String   @map("author_name") @db.VarChar(80)
  body           String   @db.VarChar(1000)
  paragraphIndex Int?     @map("paragraph_index")
  likes          Int      @default(0)
  downvotes      Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  story          Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter        Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  parent         ChapterComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        ChapterComment[] @relation("CommentReplies")
  author         User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  votes          CommentVote[]

  @@index([chapterId, createdAt(sort: Desc)])
  @@index([storyId])
  @@index([parentId])
  @@map("chapter_comments")
}

model CommentVote {
  commentId String         @map("comment_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  value     Int
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  comment   ChapterComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([commentId, value])
  @@map("comment_votes")
}

model UserFollow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
  @@map("user_follows")
}

model WallPost {
  id            String   @id @default(uuid()) @db.Uuid
  profileUserId String   @map("profile_user_id") @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  body          String   @db.VarChar(1000)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  profileUser   User     @relation("WallPostProfile", fields: [profileUserId], references: [id], onDelete: Cascade)
  author        User     @relation("WallPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([profileUserId, createdAt(sort: Desc)])
  @@map("wall_posts")
}

model ChapterRevision {
  id             String   @id @default(uuid()) @db.Uuid
  chapterId      String   @map("chapter_id") @db.Uuid
  version        Int
  title          String   @db.VarChar(150)
  contentJson    Json     @map("content_json")
  plainText      String   @map("plain_text")
  reason         String   @default("autosave") @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("created_at")
  chapter        Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, version])
  @@index([chapterId, createdAt(sort: Desc)])
  @@map("chapter_revisions")
}

model StoryRating {
  storyId   String   @map("story_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@index([storyId])
  @@map("story_ratings")
}

model ReadingEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @unique @map("event_id") @db.VarChar(120)
  storyId       String   @map("story_id") @db.Uuid
  chapterId     String   @map("chapter_id") @db.Uuid
  readerKey     String   @map("reader_key") @db.VarChar(100)
  eventType     String   @map("event_type") @db.VarChar(40)
  activeSeconds Int      @default(0) @map("active_seconds")
  createdAt     DateTime @default(now()) @map("created_at")
  story         Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt(sort: Desc)])
  @@index([storyId, readerKey])
  @@map("reading_events")
}
