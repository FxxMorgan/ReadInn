NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://readinn:replace-with-a-strong-local-password@localhost:5432/readinn
APP_WEB_URL=http://localhost:8080
TRUSTED_PROXY_IPS=127.0.0.1,::1
LOG_LEVEL=info
JWT_SECRET=replace-with-at-least-32-random-characters
ANALYTICS_SALT=replace-with-a-separate-random-secret
READINN_FIXTURE_MODE=false
CACHE_ENABLED=true
CACHE_DIR=.cache/readinn
CACHE_TTL_SECONDS=900
